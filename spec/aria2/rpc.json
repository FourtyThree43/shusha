[
  {
    "name": "aria2.addUri",
    "category": "downloads",
    "description": "Adds a new download. uris is an array of HTTP/FTP/SFTP/BitTorrent Magnet URIs pointing to the same resource.",
    "parameters": [
      {
        "name": "uris",
        "type": "list[str]",
        "required": true,
        "description": "Array of URIs for the file."
      },
      {
        "name": "options",
        "type": "dict[str, str]",
        "required": false,
        "description": "Download-scoped aria2 options."
      },
      {
        "name": "position",
        "type": "int",
        "required": false,
        "description": "Queue position (0-based)."
      }
    ],
    "returns": {
      "type": "str",
      "description": "GID of the newly registered download."
    },
    "errors": [
      1,
      28
    ],
    "authentication_required": true
  },
